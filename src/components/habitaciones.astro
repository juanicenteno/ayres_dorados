---
import "../styles/habitaciones.css";

const rooms = [
    {
        id: "doble",
        name: "Habitación Doble",
        capacity: "2 + 1 cama extra",
        price: 180.000,
        img: "/room1.webp",
        imgAlt: "Habitación Doble — Hotel Ayres Dorados Lodge",
        whatsapp: "https://wa.me/5493764804006?text=Hola%2C%20me%20interesa%20la%20Habitaci%C3%B3n%20Doble%20en%20el%20Hotel%20Ayres%20Dorados.%20Me%20gustar%C3%ADa%20consultar%20disponibilidad.",
        amenities: {
            "Descanso": ["Cama doble king", "Almohadas de pluma", "Ropa de cama premium", "Cama extra disponible"],
            "Baño": ["Baño privado", "Ducha de lluvia", "Amenities de cortesía", "Secador de pelo"],
            "Tecnología": ["Smart TV 43\"", "Wi-Fi de alta velocidad", "Cargadores USB", "Caja fuerte digital"],
            "Comodidades": ["Aire acondicionado", "Minibar", "Vista al jardín", "Servicio a la habitación"],
        }
    },
    // Agregá más habitaciones acá siguiendo la misma estructura
];
---

    <section id="booking-rooms-list-container">
        {rooms.map((room) => (
            <article class="booking-room-item">
                <picture>
                    <img
                        src={room.img}
                        alt={room.imgAlt}
                        loading="lazy"
                    />
                </picture>

                <div class="booking-room-item-desc">
                    <article>
                        <h3>{room.name}</h3>

                        <div class="room-price">
                            <span class="room-price-amount">$ {room.price}</span>
                            <span class="room-price-label">/ noche</span>
                        </div>

                        <div class="room-divider">
                            <span>comodidades</span>
                        </div>

                        <div class="room-size">
                            <!-- Ícono personas -->
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M3 19V18C3 15.7909 4.79086 14 7 14H11C13.2091 14 15 15.7909 15 18V19M15 11C16.6569 11 18 9.65685 18 8C18 6.34315 16.6569 5 15 5M21 19V18C21 15.7909 19.2091 14 17 14H16.5M12 8C12 9.65685 10.6569 11 9 11C7.34315 11 6 9.65685 6 8C6 6.34315 7.34315 5 9 5C10.6569 5 12 6.34315 12 8Z"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>{room.capacity}</span>
                        </div>

                        <ul class="room-items">
                            <!-- Parking -->
                            <li title="Estacionamiento">
                                <svg xmlns="http://www.w3.org/2000/svg" height="16" viewBox="0 0 24 24" width="16">
                                    <path d="M0 0h24v24H0z" fill="none"/>
                                    <path d="M13 3H6v18h4v-6h3c3.31 0 6-2.69 6-6s-2.69-6-6-6zm.2 8H10V7h3.2c1.1 0 2 .9 2 2s-.9 2-2 2z"/>
                                </svg>
                            </li>
                            <!-- WiFi -->
                            <li title="Wi-Fi">
                                <svg xmlns="http://www.w3.org/2000/svg" height="16" viewBox="0 0 24 24" width="16">
                                    <path d="M0 0h24v24H0z" fill="none"/>
                                    <path d="M1 9l2 2c4.97-4.97 13.03-4.97 18 0l2-2C16.93 2.93 7.08 2.93 1 9zm8 8l3 3 3-3c-1.65-1.66-4.34-1.66-6 0zm-4-4l2 2c2.76-2.76 7.24-2.76 10 0l2-2C15.14 9.14 8.87 9.14 5 13z"/>
                                </svg>
                            </li>
                            <!-- Floco de nieve / AC -->
                            <li title="Aire acondicionado">
                                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="rgba(30, 28, 25, 0.6)">
                                    <path d="M11.9994 3V7M11.9994 7V17M11.9994 7L8.99943 4M11.9994 7L14.9994 4M11.9994 17V21M11.9994 17L8.99943 20M11.9994 17L14.9994 20M4.20624 7.49999L7.67034 9.49999M7.67034 9.49999L16.3306 14.5M7.67034 9.49999L3.57227 10.5981M7.67034 9.49999L6.57227 5.40191M16.3306 14.5L19.7947 16.5M16.3306 14.5L17.4287 18.5981M16.3306 14.5L20.4287 13.4019M4.2067 16.5L7.6708 14.5M7.6708 14.5L16.3311 9.49999M7.6708 14.5L3.57273 13.4019M7.6708 14.5L6.57273 18.5981M16.3311 9.49999L19.7952 7.49999M16.3311 9.49999L17.4291 5.40192M16.3311 9.49999L20.4291 10.5981"
                                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </li>
                            <!-- TV -->
                            <li title="Smart TV">
                                <svg fill="#000000" height="16px" width="16px" viewBox="0 0 50 50" xmlns="http://www.w3.org/2000/svg">
                                    <g><path d="M1,38h23v3H12v2h26v-2H26v-3h23V8H1V38z M3,10h44v26H3V10z"/></g>
                                </svg>
                            </li>
                        </ul>

                        <button
                            class="mas-ventajas"
                            data-room={room.id}
                            aria-haspopup="dialog"
                        >
                            Ver todas las comodidades
                        </button>

                        <a
                            href={room.whatsapp}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="booking-room-item-link"
                        >
                            <!-- WhatsApp -->
                            <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
                                <path d="M11.42 9.49c-.19-.09-1.1-.54-1.27-.61s-.29-.09-.42.1-.48.6-.59.73-.21.14-.4 0a5.13 5.13 0 0 1-1.49-.92 5.25 5.25 0 0 1-1-1.29c-.11-.18 0-.28.08-.38s.18-.21.28-.32a1.39 1.39 0 0 0 .18-.31.38.38 0 0 0 0-.33c0-.09-.42-1-.58-1.37s-.3-.32-.41-.32h-.4a.72.72 0 0 0-.5.23 2.1 2.1 0 0 0-.65 1.55A3.59 3.59 0 0 0 5 8.2 8.32 8.32 0 0 0 8.19 11c.44.19.78.3 1.05.39a2.53 2.53 0 0 0 1.17.07 1.93 1.93 0 0 0 1.26-.88 1.67 1.67 0 0 0 .11-.88c-.05-.07-.17-.12-.36-.21z"/>
                                <path d="M13.29 2.68A7.36 7.36 0 0 0 8 .5a7.44 7.44 0 0 0-6.41 11.15l-1 3.85 3.94-1a7.4 7.4 0 0 0 3.55.9H8a7.44 7.44 0 0 0 5.29-12.72zM8 14.12a6.12 6.12 0 0 1-3.15-.87l-.22-.13-2.34.61.62-2.28-.14-.23a6.18 6.18 0 0 1 9.6-7.65 6.12 6.12 0 0 1 1.81 4.37A6.19 6.19 0 0 1 8 14.12z"/>
                            </svg>
                            <span>Consultar disponibilidad</span>
                        </a>
                    </article>
                </div>
            </article>
        ))}
    </section>

    <!-- ─── MODALES ─────────────────────────────────────────────── -->
    {rooms.map((room) => (
        <div
            class="modal-overlay"
            id={`modal-${room.id}`}
            role="dialog"
            aria-modal="true"
            aria-labelledby={`modal-title-${room.id}`}
        >
            <div class="modal-box">
                <div class="modal-header">
                    <div>
                        <h4 id={`modal-title-${room.id}`}>{room.name}</h4>
                        <p>Todas las comodidades</p>
                    </div>
                    <button class="modal-close" data-close={room.id} aria-label="Cerrar">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <line x1="18" y1="6" x2="6" y2="18"/>
                            <line x1="6" y1="6" x2="18" y2="18"/>
                        </svg>
                    </button>
                </div>
                <div class="modal-body">
                    {Object.entries(room.amenities).map(([category, items]) => (
                        <div class="modal-category">
                            <p class="modal-category-title">{category}</p>
                            <ul class="modal-amenity-list">
                                {items.map((item) => (
                                    <li>{item}</li>
                                ))}
                            </ul>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    ))}

<script>
    // Abrir modal
    document.querySelectorAll<HTMLButtonElement>('.mas-ventajas').forEach((btn) => {
        btn.addEventListener('click', () => {
            const roomId = btn.dataset.room;
            const modal = document.getElementById(`modal-${roomId}`);
            if (modal) {
                modal.classList.add('is-open');
                document.body.style.overflow = 'hidden';
            }
        });
    });

    // Cerrar con botón X
    document.querySelectorAll<HTMLButtonElement>('.modal-close').forEach((btn) => {
        btn.addEventListener('click', () => {
            closeModal(btn.dataset.close!);
        });
    });

    // Cerrar haciendo click en el overlay
    document.querySelectorAll<HTMLElement>('.modal-overlay').forEach((overlay) => {
        overlay.addEventListener('click', (e) => {
            if (e.target === overlay) {
                overlay.classList.remove('is-open');
                document.body.style.overflow = '';
            }
        });
    });

    // Cerrar con Escape
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            document.querySelectorAll('.modal-overlay.is-open').forEach((m) => {
                m.classList.remove('is-open');
            });
            document.body.style.overflow = '';
        }
    });

    function closeModal(roomId: string) {
        const modal = document.getElementById(`modal-${roomId}`);
        if (modal) {
            modal.classList.remove('is-open');
            document.body.style.overflow = '';
        }
    }
</script>