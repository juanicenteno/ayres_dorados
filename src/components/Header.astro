---
    import '../styles/header.css';
    const pathname = Astro.url.pathname.replace(/\/$/, "");
    const fitHref = (pathname === "" || pathname === "/") ? "#fit-promo" : "/#fit-promo";
---

<div class="header_wrapper">
    <a href={fitHref} class="marquee_bar" aria-label="FIT Argentina 2026">
        <div class="marquee_track">
            <div class="marquee_group">
                <span class="marquee_logo_badge">
                    <img src="/images/fit.png" alt="FIT 2026" class="marquee_logo_img" />
                </span>
                <span class="marquee_highlight">FIT 2026</span>
                <span>¡Estaremos presentes en FIT Argentina 2026!</span>
                <span class="marquee_sep">•</span>
                <span class="marquee_badge">Del 26 al 29 de Septiembre · La Rural, Buenos Aires</span>
                <span class="marquee_sep">•</span>
                <span class="marquee_stand_badge">📍 Stand Nac – 1012</span>
                <span class="marquee_sep">•</span>
            </div>
            <div class="marquee_group" aria-hidden="true">
                <span class="marquee_logo_badge">
                    <img src="/images/fit.png" alt="FIT 2026" class="marquee_logo_img" />
                </span>
                <span class="marquee_highlight">FIT 2026</span>
                <span>¡Estaremos presentes en FIT Argentina 2026!</span>
                <span class="marquee_sep">•</span>
                <span class="marquee_badge">Del 26 al 29 de Septiembre · La Rural, Buenos Aires</span>
                <span class="marquee_sep">•</span>
                <span class="marquee_stand_badge">📍 Stand Nac – 1012</span>
                <span class="marquee_sep">•</span>
            </div>
            <div class="marquee_group" aria-hidden="true">
                <span class="marquee_logo_badge">
                    <img src="/images/fit.png" alt="FIT 2026" class="marquee_logo_img" />
                </span>
                <span class="marquee_highlight">FIT 2026</span>
                <span>¡Estaremos presentes en FIT Argentina 2026!</span>
                <span class="marquee_sep">•</span>
                <span class="marquee_badge">Del 26 al 29 de Septiembre · La Rural, Buenos Aires</span>
                <span class="marquee_sep">•</span>
                <span class="marquee_stand_badge">📍 Stand Nac – 1012</span>
                <span class="marquee_sep">•</span>
            </div>
        </div>
    </a>

    <header id="header">
    <section class="content_header">
        <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="size-6"
            style="cursor: pointer;"
            role="button"
            aria-label="Abrir menú de navegación"
            tabindex="0"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
        </svg>

        <a href="/" class="logo_container">
            <img src="/logo_black.png" alt="Ayres Dorados Lodge Logo" />
        </a>
        <ul class="list_link_desktop">
            <li><a href="/" class={pathname === "" ? "active" : ""}>Inicio</a></li>
            <li><a href="/restaurante" class={pathname === "/restaurante" ? "active" : ""}>Restaurante</a></li>
            <li><a href="/contacto" class={pathname === "/contacto" ? "active" : ""}>Contacto</a></li>
            <li><a href="https://reservas.ayresdorados.com" target="_blank">Reservar</a></li>
            <li><a href="/galeria" class={pathname === "/galeria" ? "active" : ""}>Galería</a></li>
        </ul>
    </section>
    <nav class="mobile_nav">
        <ul class="list_link">
            <li><a href="/" class={pathname === "" ? "active" : ""}>Inicio</a></li>
            <li><a href="/restaurante" class={pathname === "/restaurante" ? "active" : ""}>Restaurante</a></li>
            <li><a href="/contacto" class={pathname === "/contacto" ? "active" : ""}>Contacto</a></li>
            <li><a href="https://reservas.ayresdorados.com" target="_blank">Reservar</a></li>
            <li><a href="/galeria" class={pathname === "/galeria" ? "active" : ""}>Galería</a></li>
        </ul>
    </nav>
</header>
</div>

<script>
    document.addEventListener('astro:page-load', () => {
        const header = document.getElementById("header");
        const btn = header?.querySelector("svg");
        const mobile_nav = header?.querySelector(".mobile_nav");
        const list_links = header?.querySelector(".list_link");
        
        function toggleMenu() {
            mobile_nav?.classList.toggle("active");
            list_links?.classList.toggle("active");
        }

        btn?.addEventListener("click", toggleMenu);
        btn?.addEventListener("keydown", (e) => {
            if (e.key === "Enter" || e.key === " ") {
                e.preventDefault();
                toggleMenu();
            }
        });
    });
</script>
