---
import "../styles/fit_banner.css";
---

<article id="fit-promo" class="fit_promo">
    <div class="fit_promo__hero">
        <img
            src="/images/fit_bg.webp"
            alt="Ayres Dorados en FIT Argentina 2026"
            class="fit_promo__heroImg"
            loading="lazy"
        />
        <div class="fit_promo__heroScrim" aria-hidden="true"></div>

        <div class="fit_promo__heroContent">
            <!-- Fila superior de Logos y Stand -->
            <div class="fit_promo__logosRow">
                <img
                    src="/logo_white.png"
                    alt="Ayres Dorados Lodge Logo"
                    class="fit_promo__logoAyres"
                />
                <div class="fit_promo__badgesGroup">
                    <div class="fit_promo__fitLogoBadge">
                        <img
                            src="/images/fit.png"
                            alt="FIT 2026 - Feria Internacional de Turismo"
                            class="fit_promo__fitLogoImg"
                        />
                    </div>
                    <div class="fit_promo__standBadge">
                        <span class="fit_promo__standPin" aria-hidden="true">📍</span>
                        <span>STAND NAC – 1012</span>
                    </div>
                </div>
            </div>

            <!-- Cuerpo del Banner: info + flyer card -->
            <div class="fit_promo__body">
                <div class="fit_promo__left">
                    <div class="fit_promo__headerText">
                        <span class="fit_promo__eyebrow">
                            ✦ Feria Internacional de Turismo
                        </span>
                        <h2 class="fit_promo__title">
                            FIT Argentina 2026
                        </h2>
                        <p class="fit_promo__tagline">
                            ¡Ayres Dorados estará presente!
                        </p>
                    </div>

                    <ul class="fit_promo__pills">
                        <li class="fit_promo__pill">
                            <span class="fit_promo__pillIcon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                            </span>
                            <span>26 al 29 de Septiembre, 2026</span>
                        </li>
                        <li class="fit_promo__pill">
                            <span class="fit_promo__pillIcon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
                            </span>
                            <span>La Rural, Buenos Aires</span>
                        </li>
                        <li class="fit_promo__pill fit_promo__pill--stand">
                            <span class="fit_promo__pillIcon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18" /><path d="M5 21V7l8-4v18" /><path d="M19 21V11l-6-4" /><path d="M9 9v.01" /><path d="M9 12v.01" /><path d="M9 15v.01" /><path d="M9 18v.01" /></svg>
                            </span>
                            <span class="fit_promo__pillTextHighlight">Stand Nac – 1012</span>
                        </li>
                    </ul>

                    <div class="fit_promo__textBlock">
                        <p class="fit_promo__desc">
                            Será una linda oportunidad para volver a encontrarnos, conversar, compartir las novedades de Ayres Dorados Lodge y seguir proyectando juntos las próximas temporadas.
                        </p>
                        <p class="fit_promo__note">
                            Si van a estar en FIT, nos encantará que pasen a visitarnos. Quienes quieran coordinar una reunión, pueden contactarnos y acordamos día y horario.
                        </p>
                    </div>
                </div>

                <div class="fit_promo__right">
                    <div class="fit_promo__flyerCard">
                        <img
                            src="/fit-ayres.png"
                            alt="Flyer Ayres en FIT 2026"
                            class="fit_promo__flyerImg"
                            loading="lazy"
                        />
                        <div class="fit_promo__flyerBadge">
                            <span>📍 Stand Nac – 1012</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bloque CTA & Contacto -->
            <div class="fit_promo__ctaBlock">
                <a
                    class="fit_promo__cta"
                    href="https://wa.me/5493764804006?text=Hola!%20Me%20contacto%20desde%20la%20web%20para%20coordinar%20una%20reuni%C3%B3n%20en%20la%20FIT%20Argentina%202026%20(Stand%20Nac%201012)"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Agendar Reunión para FIT Argentina 2026"
                >
                    <svg class="fit_promo__ctaIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                    <span>AGENDAR REUNIÓN</span>
                </a>

                <div class="fit_promo__contactLines">
                    <a href="mailto:comercial@ayresdecalafate.com?subject=Reunión%20FIT%20Argentina%202026%20-%20Ayres%20Dorados%20Lodge" class="fit_promo__contactLink">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                        <span>comercial@ayresdecalafate.com</span>
                    </a>
                    <a href="tel:+5493764804006" class="fit_promo__contactLink">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                        <span>+54 9 3764 80-4006</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <footer class="fit_promo__footer">
        <p class="fit_promo__footerNote">📍 Stand Nac – 1012 · La Rural, Buenos Aires · ¡Los esperamos en FIT!</p>
    </footer>
</article>
