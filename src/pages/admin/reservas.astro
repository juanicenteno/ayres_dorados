---
import "../../styles/reservas.css";
import Layout from "../../layouts/Layout.astro";
---

<Layout>
    <section class="reservas-section">
        <header class="reservas-header">
            <em class="reservas-eyebrow">Sistema de Reservas</em>
            <h2>Ayres Dorados Lodge</h2>
        </header>

        <div class="reservas-card">
            <div class="form-group">
                <label for="titular">Titular de la reserva</label>
                <input
                    type="text"
                    id="titular"
                    placeholder="Apellido y nombre"
                    autocomplete="off"
                />
            </div>

            <div class="row-2">
                <div class="form-group">
                    <label for="habitacion">Habitacion</label>
                    <div class="select-wrap">
                        <select id="habitacion">
                            <option value="">- Elegir -</option>
                            {
                                Array.from({ length: 20 }, (_, i) => i + 1).map(
                                    (n) => (
                                        <option value={n}>
                                            Habitacion {n}
                                        </option>
                                    ),
                                )
                            }
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label for="pax">Huespedes</label>
                    <div class="select-wrap">
                        <select id="pax">
                            <option value="1">1 pax</option>
                            <option value="2" selected>2 pax</option>
                            <option value="3">3 pax</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="row-2">
                <div class="form-group">
                    <label for="checkin">Check-in</label>
                    <input type="date" id="checkin" />
                </div>
                <div class="form-group">
                    <label for="checkout">Check-out</label>
                    <input type="date" id="checkout" />
                </div>
            </div>

            <div class="form-group">
                <label for="notas">Notas (opcional)</label>
                <input
                    type="text"
                    id="notas"
                    placeholder="Ej: piden cama individual, late check - out.."
                />
            </div>

            <button class="btn-submit" id="btnSubmit" type="button">
                <div class="spinner" id="spinner"></div>
                <svg
                    id="btnIcon"
                    viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <path
                        d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"
                    ></path>
                </svg>
                <span id="btnText">Confirmar reserva</span>
            </button>

            <div class="toast" id="toast">
                <svg id="toastIcon" viewBox="0 0 24 24"></svg>
                <span id="toastMsg"></span>
            </div>
        </div>
    </section>
</Layout>
<script>
    // ─── REEMPLAZÁ ESTA URL ───────────────────────────────────────
    const APPS_SCRIPT_URL =
        "https://script.google.com/macros/s/AKfycbzA3qpu6iz7bzyNIbI11I3ymTzNPXEiN7GVfwVShQDBWQZ3kOWBzaHXpvqtMqT40FBv3w/exec";
    // ─────────────────────────────────────────────────────────────

    const btn = document.getElementById("btnSubmit")!;
    const spinner = document.getElementById("spinner")!;
    const btnIcon = document.getElementById("btnIcon")!;
    const btnText = document.getElementById("btnText")!;
    const toast = document.getElementById("toast")!;
    const toastMsg = document.getElementById("toastMsg")!;
    const toastIcon = document.getElementById("toastIcon")!;
    const checkinEl = document.getElementById("checkin") as HTMLInputElement;
    const checkoutEl = document.getElementById("checkout") as HTMLInputElement;

    // Fecha mínima = hoy
    const hoy = new Date().toISOString().split("T")[0];
    checkinEl.min = hoy;
    checkoutEl.min = hoy;

    checkinEl.addEventListener("change", () => {
        checkoutEl.min = checkinEl.value;
        if (checkoutEl.value && checkoutEl.value < checkinEl.value) {
            checkoutEl.value = "";
        }
    });

    function mostrarToast(tipo: "success" | "error", mensaje: string) {
        toast.className = `toast ${tipo}`;
        toastMsg.textContent = mensaje;
        toastIcon.innerHTML =
            tipo === "success"
                ? '<path fill="currentColor" d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/>'
                : '<path fill="currentColor" d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>';
        toast.classList.add("show");
    }

    function setLoading(estado: boolean) {
        (btn as HTMLButtonElement).disabled = estado;
        (spinner as HTMLElement).style.display = estado ? "block" : "none";
        (btnIcon as HTMLElement).style.display = estado ? "none" : "block";
        btnText.textContent = estado ? "Enviando…" : "Confirmar reserva";
    }

    btn.addEventListener("click", async () => {
        toast.className = "toast";

        const titular = (
            document.getElementById("titular") as HTMLInputElement
        ).value.trim();
        const habitacion = (
            document.getElementById("habitacion") as HTMLSelectElement
        ).value;
        const pax = (document.getElementById("pax") as HTMLSelectElement).value;
        const checkin = checkinEl.value;
        const checkout = checkoutEl.value;
        const notas = (
            document.getElementById("notas") as HTMLInputElement
        ).value.trim();

        if (!titular || !habitacion || !checkin || !checkout) {
            mostrarToast("error", "Completá todos los campos obligatorios.");
            return;
        }
        if (checkout <= checkin) {
            mostrarToast(
                "error",
                "El check-out debe ser posterior al check-in.",
            );
            return;
        }

        setLoading(true);

        try {
            const res = await fetch(APPS_SCRIPT_URL, {
                method: "POST",
                body: JSON.stringify({
                    titular,
                    habitacion,
                    pax,
                    checkin,
                    checkout,
                    notas,
                }),
            });
            const data = await res.json();

            if (data.status === "ok") {
                mostrarToast(
                    "success",
                    `✓ Reserva cargada: Hab. ${habitacion} — ${titular}`,
                );
                (document.getElementById("titular") as HTMLInputElement).value =
                    "";
                (
                    document.getElementById("habitacion") as HTMLSelectElement
                ).value = "";
                checkinEl.value = "";
                checkoutEl.value = "";
                (document.getElementById("notas") as HTMLInputElement).value =
                    "";
            } else {
                mostrarToast(
                    "error",
                    data.mensaje || "Error al guardar la reserva.",
                );
            }
        } catch {
            mostrarToast(
                "error",
                "No se pudo conectar. Revisá la URL del script.",
            );
        } finally {
            setLoading(false);
        }
    });
</script>
