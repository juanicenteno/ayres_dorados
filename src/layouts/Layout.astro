---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Booking from "../components/Booking/Booking.jsx";
import "../styles/index.css";
import { ClientRouter } from 'astro:transitions';

const { 
	title = "Ayres Dorados Lodge | Hotel boutique en Sierra Grande, Punta Colorada", 
	description = "Ayres Dorados Lodge — hotel boutique frente al mar en Punta Colorada, Sierra Grande. Confort, atención personalizada y vistas únicas al Atlántico." 
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image" href="/favicon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="/logo_black.png" />
		<meta property="og:url" content="https://ayresdorados.com" />
		<ClientRouter />
	</head>
	<body>
		<Header />
		<slot />
		<Booking client:idle />
		<Footer />
		<div class="gtranslate_wrapper"></div>

		<script is:inline>
			window.gtranslateSettings = {
				default_language: "es",
				native_language_names: true,
				detect_browser_language: true,
				languages: ["es", "en", "pt"],
				wrapper_selector: ".gtranslate_wrapper",
				float_switcher_open_direction: "bottom",
				alt_flags: { en: "usa", pt: "brazil", es: "argentina" },
			};
		</script>

		<script src="https://cdn.gtranslate.net/widgets/latest/float.js" defer
		></script>
	</body>
</html>

<style>
	* {
		margin: 0;
		padding: 0;
		border: none;
		box-sizing: border-box;
	}
	body {
		background-color: #f3eee7;
	}
</style>
